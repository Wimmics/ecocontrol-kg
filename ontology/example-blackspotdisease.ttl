@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix ecoct: <http://ns.inria.fr/ecocontrol/ontology/> .
@prefix : <http://ns.inria.fr/ecocontrol/example> .

:black_spot_affection a ecoct:Affliction ;
    ecoct:disorder :BlackSpotDisease ; # CABI ?
    ecoct:affects :Rosier ; # NCBI ?
    ecoct:affects :RoseLeaf ;
    ecoct:hasLethality "0.3"^^xsd:decimal .

:black_spot_manifestation a ecoct:Manifestation ;
    ecoct:sign :BlackSpotSymptom ;
    ecoct:hasDiagnosis :BlackSpotDisease ;
    ecoct:affects :RoseLeaf ;
    ecoct:affects :RosierVegetativeGrowth .

:BlackSpotDisease a ecoct:Disease .

:BlackSpotSymptom a ecoct:Symptom .

:Rosier a ecoct:Taxon .

:RoseLeaf a ecoct:PlantPart ;
    ecoct:partOf :Rosier ;
    skos:broader :Leaf .

:Leaf a skos:Concept .

:RosierVegetativeGrowth a ecoct:TaxonInStage ;
    ecoct:stageOf :Rosier ;
    ecoct:hasStage :VegetativeGrowth .

:VegetativeGrowth a ecoct:DevelopmentStage .