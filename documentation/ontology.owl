<?xml version="1.0"?>
<rdf:RDF xmlns="http://ns.inria.fr/ecocontrol/ontology/"
     xml:base="http://ns.inria.fr/ecocontrol/ontology/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#">
    <owl:Ontology rdf:about="http://ns.inria.fr/ecocontrol/ontology/"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2004/02/skos/core#example -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://ns.inria.fr/ecocontrol/ontology/affects -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/affects">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/Affliction"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/Manifestation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/PlantOrPlantPart"/>
        <rdfs:comment>The plant (or a plant part, possibly at a development stage) that is affected by an affliction or manifestation.</rdfs:comment>
        <rdfs:label>affects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/agent -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/agent">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/BioticDisorder"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The organism causing a disease.</rdfs:comment>
        <rdfs:label>agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/beneficiary -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/beneficiary">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsBeneficialPlantOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The (other) crop that receives the agronomic or ecological benefit.</rdfs:comment>
        <rdfs:label>beneficiary</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/cause -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/cause">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/AbioticDisorder"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/AbioticFactor"/>
        <rdfs:comment>The abiotic factor that causes a disorder.</rdfs:comment>
        <rdfs:label>cause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/commensal -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/commensal">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsCommensalOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The organism that benefits from the relationship.</rdfs:comment>
        <rdfs:label>commensal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/disease -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/disease">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/BioticDisorder"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Disease"/>
        <rdfs:comment>The disease caused by an organism to a plant.</rdfs:comment>
        <rdfs:label>disease</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/disorder -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/disorder">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/AbioticDisorder"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/Affliction"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Disorder"/>
        <rdfs:comment>A disorder resulting from an affliction or abiotic factor.</rdfs:comment>
        <rdfs:label>disorder</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/enemy -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/enemy">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:label>enemy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/harbored -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/harbored">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The organism that is harbored.</rdfs:comment>
        <rdfs:label>harbored</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/hasDiagnosis -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/hasDiagnosis">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Manifestation"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Disorder"/>
        <rdfs:comment>A disorder or disease diagnosed for the manifestation of a symptom.</rdfs:comment>
        <rdfs:label>has diagnosis</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/hasStage -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/hasStage">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/TaxonInStage"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/DevelopmentStage"/>
        <rdfs:comment>The development stage that applies to the taxon.</rdfs:comment>
        <rdfs:label>has stage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/host -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/host">
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The organism that harbors another organism.</rdfs:comment>
        <rdfs:label>host</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/hostAnimal -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/hostAnimal">
        <rdfs:subPropertyOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/host"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsCommensalOf"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The animal that harbors another organism.</rdfs:comment>
        <rdfs:label>host animal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/hostPlant -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/hostPlant">
        <rdfs:subPropertyOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/host"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/Attacks"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/BioticDisorder"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsVectorOf"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/PlantOrPlantPart"/>
        <rdfs:comment>The plant that harbors another organism.</rdfs:comment>
        <rdfs:label>host plant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/hyperparasite -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/hyperparasite">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsHyperParasiteOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:label>hyperparasite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/hyperparasitoid -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/hyperparasitoid">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsHyperParasitoidOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:label>hyperparasitoid</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/object -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/object">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/AbioticDisorder"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/PlantOrPlantPart"/>
        <rdfs:comment>The plant (or a plant part) that is affected by an abiotic factor.</rdfs:comment>
        <rdfs:label>object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/parasite -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/parasite">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsParasiteOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:label>parasite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/parasitoid -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/parasitoid">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsParasitoidOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:label>parasitoid</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/partOf -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/partOf">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/PlantPart"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:label>part of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/periodicity -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/periodicity">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/Attacks"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsRefugeOf"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Periodicity"/>
        <rdfs:comment>The frequency or regularity of an event or process.</rdfs:comment>
        <rdfs:label>periodicity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/pest -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/pest">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Attacks"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The organism that attacks a plant.</rdfs:comment>
        <rdfs:label>pest</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/predator -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/predator">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/PreysOn"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:label>predator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/prey -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/prey">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/PreysOn"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:label>prey</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/sign -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/sign">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Manifestation"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Symptom"/>
        <rdfs:comment>A symptom associated with a disorder or disease.</rdfs:comment>
        <rdfs:label>sign</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/stageOf -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/stageOf">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/TaxonInStage"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The taxon to which the development stage applies.</rdfs:comment>
        <rdfs:label>stage of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/target -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/target">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>To be completed</rdfs:comment>
        <rdfs:label>target</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/transmitted -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/transmitted">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsVectorOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>The organism that is transmitted by a vector.</rdfs:comment>
        <rdfs:label>transmitted</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/vector -->


    <owl:ObjectProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/vector">
        <rdfs:domain rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsVectorOf"/>
        <rdfs:range rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>Transmitting organism.</rdfs:comment>
        <rdfs:label>vector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://ns.inria.fr/ecocontrol/ontology/hasLethality -->


    <owl:DatatypeProperty rdf:about="http://ns.inria.fr/ecocontrol/ontology/hasLethality">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/Affliction"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>To be completed</rdfs:comment>
        <rdfs:label>has lethality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://ns.inria.fr/ecocontrol/ontology/AbioticDisorder -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/AbioticDisorder">
        <rdfs:comment>An abiotic factor causes a disorder for a plant (or a plant part, possibly at a development stage).</rdfs:comment>
        <rdfs:label>abiotic disorder</rdfs:label>
        <skos:example>The leaves burned/dried because of frost.</skos:example>
        <skos:example>The plants are affected by leaf chlorosis, it is due to lack of sunlight.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/AbioticFactor -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/AbioticFactor">
        <rdfs:comment>A non-biological factor affecting an organism or ecosystem.</rdfs:comment>
        <rdfs:label>abiotic factor</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/Affliction -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/Affliction">
        <rdfs:comment>An affliction is the result of a disorder or disease that affects a plant (or a plant part, possibly at a development stage) and eventually kills it or not.</rdfs:comment>
        <rdfs:label>affliction</rdfs:label>
        <skos:example>Brown spot is a harmful disease caused by Alternaria alternata, a pathogenic fungus. It is moderately infectious but not lethal for potato (Solanum tuberosum).</skos:example>
        <skos:example>Rose leaf affected by black spot disease.</skos:example>
        <skos:example>Septoriosis affects soft wheat.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/Attacks -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/Attacks">
        <rdfs:comment>A pest (possibly at a development stage) attacks a target plant (or a plant part, possibly at a development stage) at a period of time.</rdfs:comment>
        <rdfs:label>attacks</rdfs:label>
        <skos:example>The larvae of the Eastern pine shoot borer feed on Pinus species, mainly Pinus strobus and Pinus sylvestris.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/BioticDisorder -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/BioticDisorder">
        <rdfs:comment>An animal or a microbe (possibly at a development stage) causes a disease for a host plant (or a plant part, possibly at a development stage). Constraint: either the disease or the plant must be explicitly known (both cannot be anonymous at the same time).</rdfs:comment>
        <rdfs:label>biotic disorder</rdfs:label>
        <skos:example>The citrus mite causes acoriosis of the lemon tree.</skos:example>
        <skos:example>Xylella fastidiosa causes Pierce&apos;s disease of the grapevine.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/DevelopmentStage -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/DevelopmentStage">
        <rdfs:comment>A phase in the life cycle of an organism.</rdfs:comment>
        <rdfs:label>development stage</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/Disease -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/Disease">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Disorder"/>
        <rdfs:comment>Pathological state resulting from a biotic cause.</rdfs:comment>
        <rdfs:label>disease</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/Disorder -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/Disorder">
        <rdfs:comment>Pathological state resulting from a biotic cause (disease) or an abiotic or physiological cause (nutritional disorder, drought).</rdfs:comment>
        <rdfs:label>disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsAlternativeHostPlantOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsAlternativeHostPlantOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf"/>
        <rdfs:comment>Secondary plant that supports a pest, a pathogen or an organism during at least one stage of its life cycle, in the absence of the primary host plant. Often used during an unfavorable period (e.g. winter) or for a specific phase of the cycle (e.g. sexual reproduction for some pathogens).</rdfs:comment>
        <rdfs:label>is alternative host plant of</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsBeneficialPlantOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsBeneficialPlantOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf"/>
        <rdfs:comment>Cultivated or non-cultivated plant, intentionally introduced or encouraged or maintained, providing an agronomic or ecological benefit for a crop (called beneficiary). Examples: protecting crops from a bioaggressor, either by directly attracting the bioaggressor (trap plant) to draw it away from the crops, or by attracting auxiliary insects (predators, parasitoids, food insects of vectors, etc.).</rdfs:comment>
        <rdfs:label>is beneficial plant of</rdfs:label>
        <skos:example>The flowers of yarrow (Achillea millefolium) provide nectar and pollen to various auxiliary insects, such as bees or hoverflies and some parasitoids. Hoverfly larvae can then consume aphids present on the crops. Bees allow the pollination of the beneficiary crop.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsCommensalOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsCommensalOf">
        <rdfs:comment>An animal or microbe is a commensal of an animal. The commensal (the species that benefits from the association) may obtain from the host nutrients, shelter, support or a means of locomotion. The host is not significantly affected.</rdfs:comment>
        <rdfs:label>is commensal of</rdfs:label>
        <skos:example>Some epiphytic bacteria, such as Pseudomonas spp., use the exudates present on the surface of the leaves of a cultivated plant as a source of nutrients and as a habitat, without significantly affecting the plant.</skos:example>
        <skos:example>Vector insects are possibly hosts of commensal microbes (rare), actually more often mutualists or parasites, rather than strict commensals.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf">
        <rdfs:comment>Generic relation between a plant and the organism that it harbors.</rdfs:comment>
        <rdfs:label>is host plant of</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsHyperParasiteOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsHyperParasiteOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsParasiteOf"/>
        <rdfs:comment>An animal (possibly at a development stage) is a parasite of an animal (possibly at a development stage), itself a parasite of another animal.</rdfs:comment>
        <rdfs:label>is hyper-parasite of</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsHyperParasitoidOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsHyperParasitoidOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsParasitoidOf"/>
        <rdfs:comment>An animal (possibly at a development stage) is a parasitoid of an animal (possibly at a development stage) that is itself a parasitoid.</rdfs:comment>
        <rdfs:label>is hyper-parasitoid of</rdfs:label>
        <skos:example>Dendrocerus carpenteri, a small wasp that parasitizes other parasitoid wasps, particularly Aphidius species, which are primary parasitoids of aphids.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf">
        <rdfs:comment>An animal (possibly at a development stage) is a natural enemy of another animal (possibly at a development stage).</rdfs:comment>
        <rdfs:label>is natural enemy of</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsParasiteOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsParasiteOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf"/>
        <rdfs:comment>An animal (possibly at a development stage) is a parasite of an animal (possibly at a development stage). Lethality is not necessary for the parasite (unlike parasitoidism), even though the host may die in some cases.</rdfs:comment>
        <rdfs:label>is parasite of</rdfs:label>
        <skos:example>Trichogramma brassicae, a small parasitoid wasp, which parasitizes the eggs of certain pest insects, notably the corn borer (Ostrinia nubilalis).</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsParasitoidOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsParasitoidOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf"/>
        <rdfs:comment>An animal (possibly at a development stage) is a parasitoid of an animal (possibly at a development stage) that it inevitably kills during or at the end of its development. An insect is said to be host of its parasitoid. Likewise, a parasitoid is host of its hyperparasitoid. Parasitoidism is a special case of parasitism in conjunction with predation (but different from PreysOn, which implies a brief relation). Lethality is the norm (majority of cases). If the host does not die, this usually means the death of the parasitoid.</rdfs:comment>
        <rdfs:label>is parasitoid of</rdfs:label>
        <skos:example>Ageniaspis citricola is a wasp parasite of the citrus leafminer larva, Phyllocnistis citrella.</skos:example>
        <skos:example>Trichogramma wasps are released in crops to control the corn borer.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsPrimaryHostPlantOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsPrimaryHostPlantOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf"/>
        <rdfs:comment>Main cultivated plant on which a pest, a pathogen or an organism develops, reproduces or causes damage in an optimal way. Often the target crop or the most susceptible plant.</rdfs:comment>
        <rdfs:label>is primary host plant of</rdfs:label>
        <skos:example>For Candidatus Phytoplasma vitis, the flavescence dorée phytoplasma, the primary host is the cultivated grapevine (Vitis vinifera).</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsRefugeOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsRefugeOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf"/>
        <rdfs:comment>A refuge plant is a non-cultivated plant, offering habitat, food (sap, alternative prey) or protection (egg-laying site) to a harmful or beneficial insect, during unfavorable conditions (cold, drought, temporary absence of the crop). The insect can be a pest, a vector (itself host of the pest or pathogen of something else), or a parasitoid of a pest.</rdfs:comment>
        <rdfs:label>is refuge of</rdfs:label>
        <skos:example>During winter, the hazel (Corylus avellana) is a refuge for predatory mites (Phytoseiidae) of phytophagous mites such as the red mite (Panonychus ulmi); in spring, the predatory mites can colonize the grapevine (Vitis vinifera) and take part in regulation.</skos:example>
        <skos:example>The psyllid Cacopsylla pruni, vector of the phytoplasma &apos;Candidatus Phytoplasma prunorum&apos;, leaves Prunus in summer and uses conifers such as Norway spruce (Picea abies) as overwintering hosts; in early spring, adults return to fruit trees of the genus Prunus, such as plum (Prunus domestica), where they reproduce and can transmit the phytoplasma.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsReservoirOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsReservoirOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsHostPlantOf"/>
        <rdfs:comment>A reservoir plant is a non-cultivated plant: wild, become wild (e.g. abandoned vine crop), or adventice, which harbors and maintains (often permanently or cyclically) a potential source of contamination for cultivated plants. This excludes auxiliary plants, which have a positive role and are used for it. In ecology, the term alternative host plant is rather used (more general than refuge or reservoir).</rdfs:comment>
        <rdfs:label>is reservoir of</rdfs:label>
        <skos:example>Wild, abandoned vines or infected vine regrowth (Vitis vinifera subsp. sylvestris): they can constitute reservoirs of the flavescence dorée phytoplasma Candidatus Phytoplasma vitis and harbor its vector insect, Scaphoideus titanus.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/IsVectorOf -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/IsVectorOf">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsCommensalOf"/>
        <rdfs:comment>An animal is a vector of an animal/microbe (transmitted) for a host plant. The transmitted organism may be pathogenic (but not necessarily) for the host plant. Vector is understood here in the biotic sense, not to be confused with an abiotic vector, which is a means of dissemination (of a pest or pathogen). Vector is a type of commensalism: the transmitted animal is commensal of the vector animal.</rdfs:comment>
        <rdfs:label>is vector of</rdfs:label>
        <skos:example>Xylella fastidiosa is a bacterium that spreads from one plant to another through sap-sucking insects, such as leafhoppers, which feed on plant sap and transmit the bacterium as they move between plants.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/Manifestation -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/Manifestation">
        <rdfs:comment>A symptom is the manifestation of a disorder or disease for a particular plant (or a plant part, possibly at a development stage).</rdfs:comment>
        <rdfs:label>manifestation</rdfs:label>
        <skos:example>Leaf chlorosis affects the leaf of the grapevine.</skos:example>
        <skos:example>Symptoms manifest as the appearance of punctiform spots visible on both sides of the orange tree leaf.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/Periodicity -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/Periodicity">
        <rdfs:comment>A period of time, e.g. a seasonal, a month of the year, or other type of repetition.</rdfs:comment>
        <rdfs:label>time periodicity</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/PlantOrPlantPart -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/PlantOrPlantPart">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/PlantPart"/>
                    <rdf:Description rdf:about="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Either a plant or a part of a plant.</rdfs:comment>
        <rdfs:label>plant or plant part</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/PlantPart -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/PlantPart">
        <rdfs:comment>A part of a plant.</rdfs:comment>
        <rdfs:label>plant part</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/PreysOn -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/PreysOn">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf"/>
        <rdfs:comment>An animal (possibly at a development stage) is a predator of an animal (possibly at a development stage). The relation is brief, unlike parasitoidism, which lasts for the duration of the parasitoid&apos;s stage.</rdfs:comment>
        <rdfs:label>preys on</rdfs:label>
        <skos:example>Aeolothrips intermedius Bagnall, a cosmopolitan insect whose larvae and adults consume phytophagous thrips.</skos:example>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/Symptom -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/Symptom">
        <rdfs:comment>A sign of a disease or disorder.</rdfs:comment>
        <rdfs:label>symptom</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/Taxon -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/Taxon">
        <rdfs:comment>Set of organisms grouped based on their shared characteristics.</rdfs:comment>
        <rdfs:label>taxon</rdfs:label>
    </owl:Class>
    


    <!-- http://ns.inria.fr/ecocontrol/ontology/TaxonInStage -->


    <owl:Class rdf:about="http://ns.inria.fr/ecocontrol/ontology/TaxonInStage">
        <rdfs:subClassOf rdf:resource="http://ns.inria.fr/ecocontrol/ontology/Taxon"/>
        <rdfs:comment>A subset of a taxon with only individuals at a certain development stage.</rdfs:comment>
        <rdfs:label>taxon in stage</rdfs:label>
    </owl:Class>
</rdf:RDF>



