  }, {
    "iri" : "http://ns.inria.fr/ecocontrol/ontology/Affliction",
    "baseIri" : "http://ns.inria.fr/ecocontrol/ontology",
    "instances" : 0,
    "annotations" : {
      "example" : [ {
        "identifier" : "example",
        "language" : "undefined",
        "value" : "Brown spot is a harmful disease caused by Alternaria alternata, a pathogenic fungus. It is moderately infectious but not lethal for potato (Solanum tuberosum).",
        "type" : "label"
      }, {
        "identifier" : "example",
        "language" : "undefined",
        "value" : "Rose leaf affected by black spot disease.",
        "type" : "label"
      }, {
        "identifier" : "example",
        "language" : "undefined",
        "value" : "Septoriosis affects soft wheat.",
        "type" : "label"
      } ]
    },
    "label" : {
      "IRI-based" : "Affliction",
      "undefined" : "affliction"
    },
    "comment" : {
      "undefined" : "An affliction is the result of a disorder or disease that affects a plant (or a plant part, possibly at a development stage) and eventually kills it or not."
    },
    "id" : "14"
  }, {
    "iri" : "http://ns.inria.fr/ecocontrol/ontology/IsNaturalEnemyOf",
