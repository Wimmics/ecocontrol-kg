  }, {
    "iri" : "http://ns.inria.fr/ecocontrol/ontology/IsReservoirOf",
    "baseIri" : "http://ns.inria.fr/ecocontrol/ontology",
    "instances" : 0,
    "annotations" : {
      "example" : [ {
        "identifier" : "example",
        "language" : "undefined",
        "value" : "Wild, abandoned vines or infected vine regrowth (Vitis vinifera subsp. sylvestris): they can constitute reservoirs of the flavescence dorée phytoplasma Candidatus Phytoplasma vitis and harbor its vector insect, Scaphoideus titanus.",
        "type" : "label"
      } ]
    },
    "label" : {
      "IRI-based" : "IsReservoirOf",
      "undefined" : "is reservoir of"
    },
    "comment" : {
      "undefined" : "A reservoir plant is a non-cultivated plant: wild, become wild (e.g. abandoned vine crop), or adventice, which harbors and maintains (often permanently or cyclically) a potential source of contamination for cultivated plants. This excludes auxiliary plants, which have a positive role and are used for it. In ecology, the term alternative host plant is rather used (more general than refuge or reservoir)."
    },
    "id" : "37",
    "superClasses" : [ "27" ]
  }, {
